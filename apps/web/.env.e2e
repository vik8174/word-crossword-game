# The end-to-end build (`vite build --mode e2e`). Demo values only: nothing here
# reaches a real Firebase project, Sentry project or analytics property.
# Vite merges this file over `.env` key by key, so every key `.env` may hold that
# could reach a real service is set here, empty where it must be off.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-across-the-street.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-across-the-street
VITE_FIREBASE_STORAGE_BUCKET=demo-across-the-street.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=e2e
VITE_USE_EMULATORS=1
# Defaults. `pnpm test:e2e` overrides them from E2E_FIRESTORE_PORT and E2E_AUTH_PORT.
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_AUTH_PORT=9099
