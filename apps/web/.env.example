# Copy this file to `.env` and fill in real values from the Firebase console
# and Sentry dashboard. `.env` is git-ignored and must never be committed.

# Firebase project config - Project settings > General > Your apps > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Sentry project DSN - Project Settings > Client Keys (DSN)
VITE_SENTRY_DSN=
