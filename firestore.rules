rules_version = '2';

// Security rules for the room documents this app writes directly from the
// browser — there is no backend of ours between the players and the database
// (see docs/decisions/0002-no-dedicated-backend.md), so these rules are the
// only thing standing between a room and the open internet.
//
// What they deliberately do NOT do: hide a word from the player who has to
// guess it. Every player fetches the whole room document, hidden words
// included, and the UI is what keeps them out of sight — a conscious MVP
// decision recorded in docs/decisions/0004-ui-only-word-visibility.md.
//
// The document shape they validate is fixed by
// docs/decisions/0009-room-document-schema.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Every field a room document may hold, and no other.
    function roomFields() {
      return ['status', 'ownerId', 'layout', 'words', 'players', 'createdAt', 'expiresAt'];
    }

    function hasExactlyRoomFields(room) {
      return room.keys().hasOnly(roomFields()) && room.keys().hasAll(roomFields());
    }

    // A room must expire, must not be born already expired (a badly skewed
    // client clock would have the TTL policy delete it immediately), and must
    // not outlive the 24-hour lifetime by any meaningful margin. Every update
    // pushes this value forward, which is how a game that runs long stays
    // playable — see docs/decisions/0013-keeping-a-room-alive-on-every-write.md.
    function expiresWithinLifetime(room) {
      return room.expiresAt is timestamp
        && room.expiresAt > request.time
        && room.expiresAt < request.time + duration.value(25, 'h');
    }

    // A room whose time ran out stays out. Since every update now carries a
    // fresh expiry, checking only the value being written would let any client
    // revive a room the TTL policy has already been told to collect — and it
    // may collect it at any moment, so the game resumed in it would disappear
    // mid-word. The room screen refuses the same thing on its side, showing
    // whoever opens the link that the room has expired.
    function isStillAlive(room) {
      return room.expiresAt > request.time;
    }

    // A room is played by exactly two, and the owner alone is in it at
    // creation, so one seat is left for the guest with the link. The ceiling is
    // the room screen's `MAX_PLAYERS`, spelled in
    // apps/web/src/rooms/room-access.ts. Rules cannot import it, so the two
    // move together by hand — and they have to move together: joining writes
    // `players.<uid>` with no re-read behind it, so a client that stopped at a
    // size these rules had not stopped at yet would leave the seats between the
    // two numbers to a race, decided by nothing.
    function hasRoomForPlayers(room) {
      return room.players.size() >= 1 && room.players.size() <= 2;
    }

    // A room moves forward: it waits, it is played, it is finished. A finished
    // game stays finished — a player who opens the link afterwards must see
    // the result, not a grid someone reopened.
    function hasValidStatus(before, after) {
      return after.status in ['lobby', 'playing', 'completed']
        && (before.status != 'completed' || after.status == 'completed');
    }

    // The words are dealt out once, and only the owner deals them: they are the
    // one who knows everybody invited has arrived, and the deal cannot be taken
    // back. A room of one has nobody left to explain a hidden word, so two
    // players are the floor — the same floor the room screen shows, spelled
    // `MIN_PLAYERS` in packages/shared/src/word-assignment/types.ts. Rules
    // cannot import it, so the two move together by hand.
    function isValidStart(before, after) {
      return before.status != 'lobby'
        || after.status != 'playing'
        || (request.auth.uid == before.ownerId && after.players.size() >= 2);
    }

    // Once the words are dealt out, the room is played by exactly the people it
    // was dealt to: no key may appear in `players`, and none may disappear from
    // it. Only the lobby is open, and there the roster is the clients' to write
    // — which is what lets somebody arriving take a seat nobody is sitting in
    // (docs/decisions/0022-a-mark-a-player-writes-for-themselves.md).
    //
    // Nobody may arrive, because every word of a started room is hidden from
    // somebody who was in at the deal, so a latecomer would be handed the
    // entire word list as words to "explain" — the game given away (see
    // docs/decisions/0010-letterless-grid-and-private-word-list.md).
    //
    // Nobody may be dropped, because a word is dealt to a UID
    // (`words.<id>.hiddenFromPlayerId`) and the win is read from those same
    // fields. Take a player out of a game and their words are hidden from
    // nobody: the crossword can never be finished, and there is no way back —
    // `completed` is terminal here and `delete` is refused below.
    //
    // What is refused is the set of keys changing, not writing to `players` at
    // all: a player already in the room rewrites their own entry when they come
    // back to it, which is how reconnecting works (issue #9), and marks
    // themselves present every fifteen seconds while they are in it.
    function freezesPlayersOnceDealt(before, after) {
      return before.status == 'lobby'
        || (after.players.keys().hasOnly(before.players.keys())
          && after.players.keys().hasAll(before.players.keys()));
    }

    function isValidNewRoom() {
      let room = request.resource.data;

      return hasExactlyRoomFields(room)
        && room.status == 'lobby'
        && room.ownerId == request.auth.uid
        && room.players.keys().hasOnly([request.auth.uid])
        && room.players.keys().hasAll([request.auth.uid])
        && room.createdAt is timestamp
        && expiresWithinLifetime(room)
        // A room with no grid is unplayable, and one word state per placed
        // word is what the game reads and writes from then on.
        && room.layout.placedWords.size() > 0
        && room.layout.placedWords.size() <= 20
        && room.words.size() == room.layout.placedWords.size();
    }

    // The crossword, the owner and the birth date are settled at creation.
    // Everything a game does afterwards — players joining, words being
    // assigned and guessed, the room staying alive — touches other fields.
    function keepsRoomIdentity() {
      let before = resource.data;
      let after = request.resource.data;

      return hasExactlyRoomFields(after)
        && hasValidStatus(before, after)
        && isValidStart(before, after)
        && freezesPlayersOnceDealt(before, after)
        && after.layout == before.layout
        && after.ownerId == before.ownerId
        && after.createdAt == before.createdAt
        && after.words.size() == before.words.size()
        && hasRoomForPlayers(after)
        && isStillAlive(before)
        && expiresWithinLifetime(after);
    }

    match /rooms/{roomId} {
      // Anyone who was given the link can read the room; nobody can walk the
      // collection to discover rooms they were not invited to.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn() && isValidNewRoom();
      allow update: if isSignedIn() && keepsRoomIdentity();

      // Rooms disappear only when the TTL policy on `expiresAt` collects them,
      // never because a client asked — one player cannot end everyone's game.
      allow delete: if false;
    }

    // Nothing else in this database is reachable from a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
